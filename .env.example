# Copy to .env and fill in. Ollama works with no key (local).
ANTHROPIC_API_KEY=
# Cheaper hosted LLMs via LiteLLM (optional). OpenRouter = one key for GLM,
# DeepSeek, Qwen, etc.; reference them in ai_routing.yaml as `openrouter/<model>`.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Ollama image tag. Default "latest" needs NVIDIA driver >=570 (incl. Pascal/CC 5.0-6.2).
# On an older driver (e.g. 550 with a GTX 10xx), pin a CUDA-12 build: OLLAMA_IMAGE_TAG=0.6.8
OLLAMA_IMAGE_TAG=
# Keep the model resident on a dedicated box (no reload lag): OLLAMA_KEEP_ALIVE=-1
OLLAMA_KEEP_ALIVE=
# Routing preset. Default is the cloud/mixed config; for a fully self-hosted box
# with no API keys use the Ollama-only preset:
# AI_ROUTING_PATH=app/config/ai_routing.ollama.yaml
AI_ROUTING_PATH=app/config/ai_routing.yaml

DATABASE_URL=sqlite+aiosqlite:///./data/tef.db
# CHANGE THIS before exposing the app. Generate: `openssl rand -hex 32`
JWT_SECRET=change-me

# Invite-code signup (closed group). Comma-separated codes. Set your own.
# Static, always-valid codes. For reusable/revocable/capped links instead, mint a
# token: `python -m scripts.make_invite new --label "Study group"`.
INVITE_CODES=friend-001,friend-002
# Public base URL used to build shareable invite links (for the make_invite CLI),
# e.g. https://tef.example.com -> https://tef.example.com/signup?invite=<token>.
PUBLIC_BASE_URL=

# Public hostname for Caddy's automatic HTTPS (production). Leave unset to serve
# plain HTTP on :80 for LAN/testing. e.g. SITE_ADDRESS=tef.example.com
SITE_ADDRESS=

# Per-user daily token budgets for metered AI features (cost guard)
TUTOR_DAILY_TOKEN_BUDGET=50000
WRITING_DAILY_TOKEN_BUDGET=100000
SPEAKING_DAILY_TOKEN_BUDGET=60000

# Speech (Phase 4) — disabled until local models are set up on a self-host box
STT_BACKEND=disabled
TTS_BACKEND=disabled
WHISPER_MODEL=large-v3
PIPER_VOICE=

# Application data cache (in-process now; swap to redis later via CACHE_BACKEND)
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1024

# S3-compatible storage (MinIO defaults shown)
S3_ENDPOINT_URL=http://localhost:9002
S3_BUCKET=tef-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
