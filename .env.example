# Copy to .env and fill in. Ollama works with no key (local).
ANTHROPIC_API_KEY=
# Cheaper hosted LLMs via LiteLLM (optional). OpenRouter = one key for GLM,
# DeepSeek, Qwen, etc.; reference them in ai_routing.yaml as `openrouter/<model>`.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_ROUTING_PATH=app/config/ai_routing.yaml

DATABASE_URL=sqlite+aiosqlite:///./data/tef.db
JWT_SECRET=change-me

# Invite-code signup (closed group). Comma-separated codes.
INVITE_CODES=friend-001,friend-002

# Per-user daily token budgets for metered AI features (cost guard)
TUTOR_DAILY_TOKEN_BUDGET=50000
WRITING_DAILY_TOKEN_BUDGET=100000
SPEAKING_DAILY_TOKEN_BUDGET=60000

# Speech (Phase 4) — disabled until local models are set up on a self-host box
STT_BACKEND=disabled
TTS_BACKEND=disabled
WHISPER_MODEL=large-v3
PIPER_VOICE=

# Application data cache (in-process now; swap to redis later via CACHE_BACKEND)
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1024

# S3-compatible storage (MinIO defaults shown)
S3_ENDPOINT_URL=http://localhost:9002
S3_BUCKET=tef-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
